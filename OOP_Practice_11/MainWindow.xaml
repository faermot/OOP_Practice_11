<Window x:Class="OOP_Practice_11.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="clr-namespace:OOP_Practice_11.View.UserControls"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        mc:Ignorable="d"
        Height="740" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border CornerRadius="10 0 0 10">
            <Border.Background>
                <SolidColorBrush Color="#1A3F69"/>
            </Border.Background>

            <StackPanel>
                <!-- Logo -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="15 35 0 0">
                    <Border CornerRadius="10" Width="40" Height="40">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#5076A1" Offset="0"/>
                                <GradientStop Color="#3D5E88" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="ПР" Foreground="#FFFFFF" FontSize="13"
                                   FontWeight="Bold" TextAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10 0 0 0" VerticalAlignment="Center">
                        <TextBlock Text="Практическая работа" FontSize="10" Foreground="#5076A1" Margin="0 0 0 2"/>
                        <TextBlock Text="№ 11" FontSize="10" Foreground="#5076A1"/>
                    </StackPanel>
                </StackPanel>

                <Separator Height="0.8" Margin="20 25 20 15" Background="#5076A1"/>

                <Button Style="{StaticResource menuButtonActive}">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Home" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="Главная" Style="{StaticResource menuButtonText}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource menuButton}">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Database" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="Данные" Style="{StaticResource menuButtonText}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource menuButton}">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Envelope" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="Сообщения" Style="{StaticResource menuButtonText}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource menuButton}">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="ShoppingCart" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="Заказы" Style="{StaticResource menuButtonText}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource menuButton}">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="AreaChart" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="Статистика" Style="{StaticResource menuButtonText}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource menuButton}">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Bitcoin" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="Доход" Style="{StaticResource menuButtonText}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource menuButton}">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="FlagCheckered" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="Реклама" Style="{StaticResource menuButtonText}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource menuButton}">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Cog" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="Настройки" Style="{StaticResource menuButtonText}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource menuButton}">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="PowerOff" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="Выйти" Style="{StaticResource menuButtonText}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- RIGHT CONTENT -->
        <Border Grid.Column="1"
                CornerRadius="0 10 10 0"
                MouseDown="Border_MouseDown">
            <Border.Background>
                <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                    <GradientStop Color="#5076A1" Offset="0"/>
                    <GradientStop Color="#3A5F8A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="170"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top bar -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Right"
                            Margin="0 0 45 10">
                    <Button Content="Сегодня" Style="{StaticResource topMenuButton}"/>
                    <Button Content="Неделя"  Style="{StaticResource topMenuButton}" Background="#1A3F69"/>
                    <Button Content="Месяц"   Style="{StaticResource topMenuButton}"/>
                    <Button Content="Год"     Style="{StaticResource topMenuButton}"/>
                </StackPanel>

                <!-- Close button -->
                <Button Content="✕"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0 8 10 0"
                        Width="28" Height="28"
                        Foreground="#BCCAF1"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand"
                        FocusVisualStyle="{x:Null}"
                        Click="CloseButton_Click"/>

                <!-- Title -->
                <TextBlock Text="Практическая №11"
                           FontSize="26"
                           Foreground="#FFFFFF"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Left"
                           Margin="50 28 0 0"/>

                <!-- Row 1: Info cards -->
                <Grid Grid.Row="1" Margin="50 8 15 15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <uc:InfoCardUserControl Grid.Column="0"
                        Title="Всего просмотров" Number="10236" Icon="Eye"
                        BorderBackground1="#33BEFF" BorderBackground2="#0044BB"
                        EllipseBackground1="#345DB8" EllipseBackground2="#0099C0"/>

                    <uc:InfoCardUserControl Grid.Column="1"
                        Title="Всего заказов" Number="12649" Icon="ShoppingBasket"
                        BorderBackground1="#DF2166" BorderBackground2="#EF617D"
                        EllipseBackground1="#9814B3" EllipseBackground2="#CC1253"/>

                    <uc:InfoCardUserControl Grid.Column="2"
                        Title="Текущий баланс" Number="2190" Icon="Money"
                        BorderBackground1="#218E59" BorderBackground2="#75BD4C"
                        EllipseBackground1="#75BD4C" EllipseBackground2="#DBE62F"/>
                </Grid>

                <!-- Row 2: Chart + Orders -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="285"/>
                    </Grid.ColumnDefinitions>

                    <!-- Profit chart -->
                    <Border CornerRadius="20"
                            Padding="25 18"
                            Background="#1A3F69"
                            Margin="50 0 10 28"
                            Grid.Column="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0 0 0 6">
                                <fa:ImageAwesome Icon="Circle" Style="{StaticResource titleIcon}"/>
                                <TextBlock Text="Прибыль:" Style="{StaticResource titleText}"/>
                            </StackPanel>

                            <lvc:CartesianChart x:Name="profitChart"
                                                Grid.Row="1"
                                                DisableAnimations="False">
                                <lvc:CartesianChart.Background>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#26376F" Offset="0"/>
                                        <GradientStop Color="#3B3B8A" Offset="1"/>
                                    </LinearGradientBrush>
                                </lvc:CartesianChart.Background>
                                <lvc:CartesianChart.DataTooltip>
                                    <lvc:DefaultTooltip Background="#24336A" Foreground="#D5E2FF"/>
                                </lvc:CartesianChart.DataTooltip>
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis MinValue="0" MaxValue="11"
                                              Foreground="#717EB2"
                                              ShowLabels="False">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator StrokeThickness="0"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis MinValue="0" MaxValue="60000"
                                              Foreground="#717EB2"
                                              ShowLabels="False">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator StrokeThickness="0"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </Grid>
                    </Border>

                    <!-- Past orders -->
                    <Border CornerRadius="20"
                            Padding="0 18"
                            Background="#1A3F69"
                            Margin="5 0 28 28"
                            Grid.Column="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="18 0 0 8">
                                <fa:ImageAwesome Icon="Circle" Style="{StaticResource titleIcon}"/>
                                <TextBlock Text="Прошлые заказы:" Style="{StaticResource titleText}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <uc:OrderUserControl Title="ПР №7"  Desc="Разработка кода - с 08:00" Icon="Code"/>
                                <uc:OrderUserControl Title="ПР №8"  Desc="Разработка кода - с 08:00" Icon="Code"/>
                                <uc:OrderUserControl Title="ПР №9"  Desc="Разработка кода - с 08:00" Icon="Code"/>
                                <uc:OrderUserControl Title="ПР №10" Desc="Разработка кода - с 08:00" Icon="Code"/>
                                <uc:OrderUserControl Title="ПР №11" Desc="Разработка кода - с 08:00" Icon="Code"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
