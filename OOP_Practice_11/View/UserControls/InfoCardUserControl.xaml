<UserControl x:Class="OOP_Practice_11.View.UserControls.InfoCardUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d"
             Height="140" Width="316"
             Name="infoCardUC">

    <Border Margin="0 0 12 0">
        <Border.Clip>
            <RectangleGeometry RadiusX="15" RadiusY="15" Rect="0 0 304 140"/>
        </Border.Clip>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1.5">
                <GradientStop Color="{Binding Path=BorderBackground1, ElementName=infoCardUC}" Offset="0"/>
                <GradientStop Color="{Binding Path=BorderBackground2, ElementName=infoCardUC}" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <!-- Decorative ellipse -->
            <Ellipse Width="230" Height="230"
                     Margin="0 -130 -90 0"
                     HorizontalAlignment="Right">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1.5">
                        <GradientStop Color="{Binding Path=EllipseBackground1, ElementName=infoCardUC}" Offset="0"/>
                        <GradientStop Color="{Binding Path=EllipseBackground2, ElementName=infoCardUC}" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Icon -->
            <fa:ImageAwesome Icon="{Binding Path=Icon, ElementName=infoCardUC}"
                             Margin="0 0 25 25"
                             Width="58" Height="58"
                             Foreground="#FFFFFF"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"/>

            <!-- Text -->
            <StackPanel Margin="22 0 0 14" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding Path=Title, ElementName=infoCardUC}"
                           Foreground="#E9E9E9"
                           FontSize="13"/>
                <TextBlock Text="{Binding Path=Number, ElementName=infoCardUC}"
                           Foreground="#FFFFFF"
                           FontSize="27"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
